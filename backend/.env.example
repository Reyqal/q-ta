# Server
APP_PORT=3000
APP_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=qta_db
DB_SSLMODE=disable

# JWT
JWT_SECRET=super-secret-key-change-in-production
JWT_EXPIRY_HOURS=24

# Tax
TAX_PERCENTAGE=0.5

# CORS
FRONTEND_URL=http://localhost:5173

# Midtrans (leave empty to use mock gateway)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# WhatsApp (leave empty to use mock)
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
